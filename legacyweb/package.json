    "@types/markdown-it": "14.2.0",
    "puppeteer-core": "25.16.0",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3"
  }
}
