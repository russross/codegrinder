{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'repo_root=$(git rev-parse --show-toplevel); exec sh \"$repo_root/.codex/hooks/session_start.sh\"'",
            "statusMessage": "Loading caveman mode"
          }
        ]
      }
    ]
  }
}
