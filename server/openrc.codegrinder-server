#!/sbin/openrc-run

name="codegrinder-server"
description="CodeGrinder Python gRPC/LTI server"

cg_user="russ"
cg_group="russ"
codegrinder_root="/home/russ/codegrinder"
workdir="${codegrinder_root}/server"
config_path="${codegrinder_root}/config.json"
grpc_bind="127.0.0.1:8080"
http_bind="127.0.0.1:8081"
pidfile="/run/${RC_SVCNAME}.pid"

depend() {
    need net localmount logger
}

start() {
    ebegin "Starting ${name}"
    start-stop-daemon \
        --start \
        --background \
        --make-pidfile \
        --pidfile "${pidfile}" \
        --chdir "${workdir}" \
        --user "${cg_user}:${cg_group}" \
        --exec /usr/bin/uv -- \
        run python main.py --config "${config_path}" --bind "${grpc_bind}" --http-bind "${http_bind}"
    eend $?
}

stop() {
    ebegin "Stopping ${name}"
    start-stop-daemon --stop --pidfile "${pidfile}" --retry TERM/30/KILL/5
    eend $?
}
