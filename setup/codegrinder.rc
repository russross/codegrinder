#!/sbin/openrc-run

depend() {
    need docker
    need ntpd
}

start_pre() {
    ewaitfile 30 /var/run/docker.sock
}

supervisor="supervise-daemon"
respawn_delay=2
respawn_max=10
respawn_period=300

command="/usr/local/bin/codegrinder"
command_args="${codegrinder_roles:--ta -daycare} --config ${codegrinder_config:-/etc/codegrinder/config.json}"
command_user="${codegrinder_user:-codegrinder}:${codegrinder_group:-codegrinder}"
command_background="true"
pidfile="/run/${RC_SVCNAME}.pid"
output_logger="logger -t ${RC_SVCNAME}"
error_logger="logger -t ${RC_SVCNAME}"
