codegrinder.example.edu {
	tls {
		protocols tls1.3
	}

	root * /usr/share/codegrinder/www

	@not_grpc not path /codegrinder.CodeGrinderService/*
	encode @not_grpc zstd gzip

	log {
		output file /var/log/caddy/codegrinder-access.log {
			mode 0640
			roll_at 03:00
			roll_keep 10
		}
		format console
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	@web_runtime path /web/* /js/*
	header @web_runtime {
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
	}

	# Revalidate the page and direct dependencies; fetched content names stay immutable.
	@vm_entry path /vm /vm/ /vm/index.html /vm/dist/app.js /vm/dist/style.css /vm/dist/favicon.svg
	header @vm_entry Cache-Control "no-cache"
	@vm_assets path /vm/dist/app-* /vm/dist/style-* /vm/dist/favicon-* /vm/vm/runtime/riscbox-*/* /vm/vm/image/risclet-*.json /vm/vm/image/drive-*/*
	header @vm_assets Cache-Control "public, max-age=31536000, immutable"

	@dynamic path /codegrinder.CodeGrinderService/* /lti/* /quiz/* /v2/version /version
	reverse_proxy @dynamic h2c://127.0.0.1:1400 {
		header_up X-Real-IP {remote_host}
	}

	file_server {
		precompressed br
	}
}
