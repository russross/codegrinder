codegrinder.example.edu {
	tls {
		protocols tls1.3
	}

	root * /usr/share/codegrinder/www

	@not_grpc not path /codegrinder.CodeGrinderService/*
	encode @not_grpc zstd gzip

	log {
		output file /var/log/caddy/codegrinder-access.log
		format console
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	@web_runtime path /web/* /js/*
	header @web_runtime {
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
	}

	# Revalidate the entry page while retaining immutable assets for cached exam pages.
	@exam_entry path /exam /exam/ /exam/index.html
	header @exam_entry Cache-Control "no-cache"
	@exam_assets path /exam/dist/app-* /exam/dist/style-* /exam/dist/favicon-* /exam/vm/runtime/riscbox-*/* /exam/vm/image/risclet-*.json /exam/vm/image/drive-*/*
	header @exam_assets Cache-Control "public, max-age=31536000, immutable"

	@dynamic path /codegrinder.CodeGrinderService/* /daycare_registrations /lti/* /v2/version /version
	reverse_proxy @dynamic h2c://localhost:1400

	file_server
}
