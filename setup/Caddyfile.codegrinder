codegrinder.example.edu {
	tls {
		protocols tls1.3
	}

	root * /usr/share/codegrinder/dist

	# Native server executables are private deployment assets.
	@server_private path /server /server/*
	respond @server_private 404

	# Preserve existing installer and download-page links during the transition.
	@grind_downloads path /grind.* /update-grind
	redir @grind_downloads /grind{uri} 308
	@old_cli path /cli /cli/*
	redir @old_cli /grind/?{query} 308

	@not_grpc not path /codegrinder.CodeGrinderService/*
	encode @not_grpc zstd gzip

	log {
		output file /var/log/caddy/codegrinder-access.log {
			mode 0640
			roll_at 03:00
			roll_keep 10
		}
		format console
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	@web_runtime path /web/* /js/*
	header @web_runtime {
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
	}

	# Content-named assets can be reused without revalidation for one week.
	@vm_assets path /client/app-* /vms/riscbox-*/* /vms/*-drive-*/*
	header @vm_assets Cache-Control "public, max-age=604800, immutable"

	@dynamic path /codegrinder.CodeGrinderService/* /lti/* /quiz/* /v2/version /version
	reverse_proxy @dynamic h2c://127.0.0.1:1400 {
		header_up X-Real-IP {remote_host}
	}

	file_server {
		precompressed br
	}
}
