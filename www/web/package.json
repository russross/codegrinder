{
  "name": "codegrinder-web",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run proto:generate && npm run typecheck && webpack",
    "proto:generate": "./proto-gen.sh",
    "test": "node --test test/*.test.js",
    "test:browser": "node --test browser-test/*.test.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json"
  },
  "dependencies": {
    "@protobuf-ts/grpcweb-transport": "2.11.1",
    "@protobuf-ts/runtime": "2.11.1",
    "@protobuf-ts/runtime-rpc": "2.11.1"
  },
  "devDependencies": {
    "@protobuf-ts/plugin": "2.11.1",
    "@types/ace": "0.0.52",
    "@types/markdown-it": "14.2.0",
    "grpc-tools": "1.13.1",
    "puppeteer-core": "25.9.0",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "webpack": "5.109.2",
    "webpack-cli": "7.2.2"
  }
}
