{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@riscbox/runtime": ["vm/build/riscbox/riscbox.d.ts"],
      "@riscbox/storage": ["vm/build/riscbox/riscbox.d.ts"]
    }
  },
  "include": ["*.ts", "*.d.ts", "google/**/*.ts", "tests/*.ts"],
  "exclude": ["node_modules", "vm"]
}
