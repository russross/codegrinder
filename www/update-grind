#!/bin/sh

set -eu

BIN_DIR=

grind_temp=
updater_temp=
risclet_temp=
installation_completed=false

cleanup() {
    exit_status=$?
    if [ -n "$grind_temp" ]; then
        rm -f "$grind_temp" || :
    fi
    if [ -n "$updater_temp" ]; then
        rm -f "$updater_temp" || :
    fi
    if [ -n "$risclet_temp" ]; then
        rm -f "$risclet_temp" || :
    fi
    if [ "$installation_completed" = false ]; then
        printf '%s\n' 'FAILED: installation did not complete.' >&2
    fi
    trap - 0
    exit "$exit_status"
}
trap cleanup 0
trap 'exit 129' 1
trap 'exit 130' 2
trap 'exit 143' 15

fail() {
    printf 'update-grind: %s\n' "$*" >&2
    exit 1
}

succeed() {
    printf 'SUCCESS: %s\n' "$*"
    installation_completed=true
}

display_path() {
    if [ -n "${HOME:-}" ]; then
        case "$1" in
            "$HOME"/*)
                printf '~/%s\n' "${1#"$HOME"/}"
                return 0
                ;;
        esac
    fi
    printf '%s\n' "$1"
}

path_line() {
    printf 'export PATH="$HOME/.local/bin:$PATH" # added by CodeGrinder installer'
}

fish_path_line() {
    printf 'contains -- "$HOME/.local/bin" $PATH; or set -gx PATH "$HOME/.local/bin" $PATH # added by CodeGrinder installer'
}

file_has_line() {
    [ -f "$1" ] || return 1
    grep -Fxq -- "$2" "$1" 2>/dev/null
}

installed_grind_is_in_path() {
    if ! grind_command=$(command -v grind 2>/dev/null); then
        return 1
    fi
    if [ "$grind_command" = "$BIN_DIR/grind" ]; then
        return 0
    fi
    [ -e "$grind_command" ] && [ "$grind_command" -ef "$BIN_DIR/grind" ]
}

resolve_zdotdir() {
    resolved_zdotdir=${ZDOTDIR:-}
    if [ -n "$resolved_zdotdir" ]; then
        return 0
    fi
    resolved_zdotdir=
    if [ -z "${HOME:-}" ] || [ ! -f "$HOME/.zshenv" ]; then
        return 0
    fi
    while IFS= read -r line || [ -n "$line" ]; do
        stripped=$(printf '%s' "$line" | sed 's/^[[:space:]]*//')
        case "$stripped" in
            export[[:space:]]*)
                stripped=$(printf '%s' "$stripped" | sed 's/^export[[:space:]][[:space:]]*//')
                ;;
        esac
        case "$stripped" in
            ZDOTDIR=*) value=${stripped#ZDOTDIR=} ;;
            *) continue ;;
        esac
        case "$value" in
            '"'* )
                value=${value#\"}
                value=${value%%\"*}
                ;;
            "'"*)
                value=${value#\'}
                value=${value%%\'*}
                ;;
            *)
                value=${value%%;*}
                value=${value%%#*}
                while :; do
                    case "$value" in
                        *[[:space:]]) value=${value%?} ;;
                        *) break ;;
                    esac
                done
                ;;
        esac
        case "$value" in
            '~') value=$HOME ;;
            '~/'*) value="$HOME/${value#\~/}" ;;
            '$HOME') value=$HOME ;;
            '$HOME'/*) value="$HOME/${value#\$HOME/}" ;;
            '${HOME}') value=$HOME ;;
            '${HOME}'/*) value="$HOME/${value#\$\{HOME\}/}" ;;
        esac
        case "$value" in
            /*) resolved_zdotdir=$value ;;
            *) resolved_zdotdir= ;;
        esac
    done <"$HOME/.zshenv"
}

record_path_file() {
    if [ -n "$path_updated_files" ]; then
        path_updated_files="$path_updated_files, $(display_path "$1")"
    else
        path_updated_files=$(display_path "$1")
    fi
}

record_present_file() {
    if [ -n "$path_present_files" ]; then
        path_present_files="$path_present_files, $(display_path "$1")"
    else
        path_present_files=$(display_path "$1")
    fi
}

append_path_line() {
    case ":$path_touched_files:" in
        *":$1:"*) return 0 ;;
    esac
    path_touched_files="$path_touched_files:$1"
    wanted_line=$(path_line)
    if file_has_line "$1" "$wanted_line"; then
        record_present_file "$1"
        return 0
    fi
    profile_directory=${1%/*}
    mkdir -p -- "$profile_directory" 2>/dev/null || return 0
    if printf '\n%s\n' "$wanted_line" >>"$1" 2>/dev/null; then
        record_path_file "$1"
    fi
}

append_fish_path_line() {
    fish_conf_dir=${XDG_CONFIG_HOME:-$HOME/.config}/fish/conf.d
    fish_file=$fish_conf_dir/grind.fish
    case ":$path_touched_files:" in
        *":$fish_file:"*) return 0 ;;
    esac
    path_touched_files="$path_touched_files:$fish_file"
    wanted_line=$(fish_path_line)
    if file_has_line "$fish_file" "$wanted_line"; then
        record_present_file "$fish_file"
        return 0
    fi
    mkdir -p -- "$fish_conf_dir" 2>/dev/null || return 0
    if printf '%s\n' "$wanted_line" >>"$fish_file" 2>/dev/null; then
        record_path_file "$fish_file"
    fi
}

configure_grind_path() {
    path_activation=
    path_updated_files=
    path_present_files=
    path_touched_files=
    if installed_grind_is_in_path; then
        return
    fi

    shell_name=${SHELL:-}
    shell_name=${shell_name##*/}
    case "$shell_name" in
        fish) manual_line="set -gx PATH \"$BIN_DIR\" \$PATH" ;;
        *) manual_line="export PATH=\"$BIN_DIR:\$PATH\"" ;;
    esac

    if [ -z "${HOME:-}" ]; then
        printf '\n%s is not on your PATH and HOME is unset. Add it yourself:\n  %s\n' \
            "$BIN_DIR" "$manual_line"
        path_activation=$manual_line
        return
    fi

    resolve_zdotdir
    zsh_dotdir=${resolved_zdotdir:-$HOME}
    zsh_rc=$zsh_dotdir/.zshrc
    zsh_profile=$zsh_dotdir/.zprofile
    fish_source=${XDG_CONFIG_HOME:-$HOME/.config}/fish/conf.d/grind.fish
    case "$shell_name" in
        zsh) source_file=$zsh_rc ;;
        bash) source_file=$HOME/.bashrc ;;
        fish) source_file=$fish_source ;;
        *) source_file=$HOME/.profile ;;
    esac

    if [ "$shell_name" = zsh ] || [ -f "$zsh_rc" ]; then
        append_path_line "$zsh_rc"
        if [ "$zsh_rc" != "$HOME/.zshrc" ] && [ -f "$HOME/.zshrc" ]; then
            append_path_line "$HOME/.zshrc"
        fi
    fi
    if [ "$shell_name" = zsh ] || [ -f "$zsh_profile" ] || [ -f "$HOME/.zprofile" ]; then
        append_path_line "$zsh_profile"
    fi
    if [ "$shell_name" = bash ] || [ -f "$HOME/.bashrc" ] \
        || [ -f "$HOME/.bash_profile" ] || [ -f "$HOME/.bash_login" ]; then
        append_path_line "$HOME/.bashrc"
        if [ -f "$HOME/.bash_profile" ]; then
            append_path_line "$HOME/.bash_profile"
        elif [ -f "$HOME/.bash_login" ]; then
            append_path_line "$HOME/.bash_login"
        else
            append_path_line "$HOME/.profile"
        fi
    fi
    if [ "$shell_name" = fish ] \
        || [ -d "${XDG_CONFIG_HOME:-$HOME/.config}/fish" ]; then
        append_fish_path_line
    fi
    case "$shell_name" in
        zsh|bash|fish) ;;
        *) append_path_line "$HOME/.profile" ;;
    esac

    printf '\n'
    if [ -n "$path_updated_files" ]; then
        printf 'Added %s to PATH in %s.\n' "$(display_path "$BIN_DIR")" "$path_updated_files"
        printf 'Restart your shell, or start in this one by running:\n'
        printf '  source %s\n' "$(display_path "$source_file")"
        printf 'Then run grind\n'
        path_activation="source $(display_path "$source_file")"
    elif [ -n "$path_present_files" ]; then
        printf 'A PATH entry for %s is already present in %s.\n' \
            "$(display_path "$BIN_DIR")" "$path_present_files"
        printf 'Restart your shell, or start in this one by running:\n'
        printf '  source %s\n' "$(display_path "$source_file")"
        printf 'Then run grind\n'
        path_activation="source $(display_path "$source_file")"
    else
        printf '%s is not on your PATH and no profile could be updated. Add it yourself:\n' \
            "$(display_path "$BIN_DIR")"
        printf '  %s\n' "$manual_line"
        path_activation=$manual_line
    fi
}

configure_server() {
    hostname=$1
    case "$hostname" in
        ''|.*|*.|*..*|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789.-]*)
            fail "invalid hostname: $hostname"
            ;;
    esac
    [ "${#hostname}" -le 253 ] || fail "hostname is too long: $hostname"

    hostname_labels=$hostname
    while :; do
        case "$hostname_labels" in
            *.*)
                hostname_label=${hostname_labels%%.*}
                hostname_labels=${hostname_labels#*.}
                ;;
            *)
                hostname_label=$hostname_labels
                hostname_labels=
                ;;
        esac
        [ "${#hostname_label}" -le 63 ] \
            || fail "hostname label is too long: $hostname_label"
        case "$hostname_label" in
            -*|*-) fail "invalid hostname label: $hostname_label" ;;
        esac
        [ -n "$hostname_labels" ] || break
    done

    server=https://$hostname
}

configure_risclet_version() {
    version_input=$1
    case "$version_input" in
        v*) version_body=${version_input#v} ;;
        *) version_body=$version_input ;;
    esac

    major_version=${version_body%%.*}
    version_remainder=${version_body#*.}
    [ "$version_remainder" != "$version_body" ] \
        || fail "invalid risclet version: $version_input"
    minor_version=${version_remainder%%.*}
    patch_version=${version_remainder#*.}
    [ "$patch_version" != "$version_remainder" ] \
        || fail "invalid risclet version: $version_input"
    case "$patch_version" in
        *.*) fail "invalid risclet version: $version_input" ;;
    esac
    for version_component in "$major_version" "$minor_version" "$patch_version"; do
        case "$version_component" in
            ''|*[!0123456789]*) fail "invalid risclet version: $version_input" ;;
        esac
    done

    risclet_requested_version=v$version_body
}

download() {
    url=$1
    destination=$2
    description=$3
    downloader_found=false

    if command -v curl >/dev/null 2>&1; then
        downloader_found=true
        if curl --fail --silent --show-error --location --max-redirs 3 \
            --proto '=https' --proto-redir '=https' --tlsv1.2 \
            "$url" -o "$destination"; then
            return
        fi
    fi
    if command -v wget >/dev/null 2>&1; then
        downloader_found=true
        if wget -q -O "$destination" "$url" 2>/dev/null; then
            return
        fi
    fi
    if command -v python3 >/dev/null 2>&1; then
        downloader_found=true
        if python3 - "$url" "$destination" 2>/dev/null <<'PYTHON'
import shutil
import sys
import urllib.request

url = sys.argv[1]
destination = sys.argv[2]
with urllib.request.urlopen(url, timeout=60) as response:
    with open(destination, "wb") as destination_file:
        shutil.copyfileobj(response, destination_file)
PYTHON
        then
            return
        fi
    fi

    if [ "$downloader_found" = false ]; then
        fail "curl, wget, or python3 is required to download $description"
    fi
    fail "could not download $description from $url"
}

reject_sudo_installation() {
    if [ "$(id -u)" -eq 0 ] && [ -n "${SUDO_USER:-}" ] \
        && [ "$SUDO_USER" != root ]; then
        fail 'run this installer without sudo'
    fi
}

remove_legacy_binary() {
    legacy_path=/usr/local/bin/$1
    if [ ! -e "$legacy_path" ] && [ ! -L "$legacy_path" ]; then
        return
    fi

    printf 'Removing legacy %s\n' "$legacy_path"
    if [ "$(id -u)" -eq 0 ]; then
        rm -f "$legacy_path" || fail "could not remove $legacy_path"
        return
    fi
    command -v sudo >/dev/null 2>&1 \
        || fail "sudo is required to remove $legacy_path"
    sudo rm -f "$legacy_path" || fail "could not remove $legacy_path"
}

detect_platform() {
    os_name=$(uname -s)
    architecture=$(uname -m)
    case "$os_name-$architecture" in
        Linux-x86_64|Linux-amd64) platform=linux_amd64 ;;
        Linux-aarch64|Linux-arm64) platform=linux_arm64 ;;
        Darwin-x86_64|Darwin-amd64) platform=darwin_amd64 ;;
        Darwin-aarch64|Darwin-arm64) platform=darwin_arm64 ;;
        *) fail "unsupported platform: $os_name on $architecture" ;;
    esac
}

validate_grind() {
    [ -s "$1" ] || fail 'downloaded grind binary is empty'
    chmod -- 0755 "$1" || fail 'could not make the downloaded grind binary executable'
    "$1" --help >/dev/null 2>&1 \
        || fail 'downloaded grind binary failed its startup check'
}

validate_updater() {
    [ -s "$1" ] || fail 'downloaded updater is empty'
    updater_first_line=
    IFS= read -r updater_first_line <"$1" || :
    [ "$updater_first_line" = '#!/bin/sh' ] \
        || fail 'downloaded updater is not a POSIX shell script'
    sh -n "$1" 2>/dev/null || fail 'downloaded updater has invalid shell syntax'
    chmod -- 0755 "$1" || fail 'could not make the downloaded updater executable'
}

install_file() {
    if [ -f "$2" ] && cmp -s -- "$1" "$2"; then
        rm -f -- "$1"
        return 0
    fi
    mv -f -- "$1" "$2" || fail "could not install $2"
}

install_grind() {
    detect_platform
    printf 'Installing grind for %s\n' "$platform"

    grind_temp=$(mktemp "$BIN_DIR/.grind.XXXXXX") \
        || fail "could not create a temporary file in $BIN_DIR"
    updater_temp=$(mktemp "$BIN_DIR/.update-grind.XXXXXX") \
        || fail "could not create a temporary file in $BIN_DIR"
    download "$server/grind.$platform" "$grind_temp" "grind for $platform"
    download "$server/update-grind" "$updater_temp" update-grind
    validate_grind "$grind_temp"
    validate_updater "$updater_temp"

    remove_legacy_binary grind
    install_file "$updater_temp" "$BIN_DIR/update-grind"
    updater_temp=
    install_file "$grind_temp" "$BIN_DIR/grind"
    grind_temp=
}

risclet_version() {
    "$1" --version 2>/dev/null | awk '
        {
            for (i = 1; i <= NF; i++) {
                if ($i ~ /^v?[0-9]+\.[0-9]+\.[0-9]+$/) {
                    sub(/^v/, "", $i)
                    print "v" $i
                    exit
                }
            }
        }
    '
}

install_risclet() {
    requested_version=$1
    installed_version=
    if [ -x "$BIN_DIR/risclet" ]; then
        installed_version=$(risclet_version "$BIN_DIR/risclet")
    fi
    if [ "$installed_version" = "$requested_version" ]; then
        remove_legacy_binary risclet
        return
    fi

    detect_platform
    case "$platform" in
        darwin_amd64) binary=risclet-x86_64-apple-darwin ;;
        darwin_arm64) binary=risclet-aarch64-apple-darwin ;;
        linux_amd64) binary=risclet-x86_64-unknown-linux-musl ;;
        linux_arm64) binary=risclet-aarch64-unknown-linux-musl ;;
    esac
    printf 'Installing risclet %s\n' "$requested_version"
    risclet_temp=$(mktemp "$BIN_DIR/.risclet.XXXXXX") \
        || fail "could not create a temporary file in $BIN_DIR"
    download "https://github.com/russross/risclet/releases/download/$requested_version/$binary" \
        "$risclet_temp" "risclet $requested_version"
    [ -s "$risclet_temp" ] || fail 'downloaded risclet binary is empty'
    chmod -- 0755 "$risclet_temp" \
        || fail 'could not make the downloaded risclet binary executable'
    downloaded_version=$(risclet_version "$risclet_temp")
    [ "$downloaded_version" = "$requested_version" ] \
        || fail "downloaded risclet did not report version $requested_version"

    remove_legacy_binary risclet
    install_file "$risclet_temp" "$BIN_DIR/risclet"
    risclet_temp=
}

if [ "$#" -ne 2 ]; then
    fail 'usage: update-grind grind HOSTNAME | update-grind risclet VERSION'
fi
case "$1" in
    grind)
        mode=grind
        configure_server "$2"
        ;;
    risclet)
        mode=risclet
        configure_risclet_version "$2"
        ;;
    *) fail 'usage: update-grind grind HOSTNAME | update-grind risclet VERSION' ;;
esac

reject_sudo_installation
[ -n "${HOME:-}" ] || fail 'HOME is not set'
BIN_DIR=$HOME/.local/bin
[ "$BIN_DIR" != / ] || fail "refusing to install into $BIN_DIR"
umask 022
mkdir -p -- "$BIN_DIR" || fail "could not create $BIN_DIR"

case "$mode" in
    grind)
        install_grind
        configure_grind_path
        if [ -n "$path_activation" ]; then
            succeed "grind installed; run $path_activation before using it."
        else
            succeed 'grind is installed and ready.'
        fi
        ;;
    risclet)
        install_risclet "$risclet_requested_version"
        succeed "risclet $risclet_requested_version is installed."
        ;;
esac
